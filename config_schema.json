{
  "title": "Yahoo Fantasy Football",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "title": "Enabled",
      "default": true
    },
    "yahoo_client_id": {
      "type": "string",
      "title": "Yahoo Client ID",
      "description": "Consumer Key from Yahoo Developer Network",
      "default": ""
    },
    "yahoo_client_secret": {
      "type": "string",
      "title": "Yahoo Client Secret",
      "description": "Consumer Secret from Yahoo Developer Network",
      "default": ""
    },
    "yahoo_refresh_token": {
      "type": "string",
      "title": "Yahoo Refresh Token",
      "description": "Refresh token from OAuth authorization code flow",
      "default": ""
    },
    "league_id": {
      "type": "string",
      "title": "League ID",
      "description": "League ID number, e.g., 12345",
      "default": ""
    },
    "game_key": {
      "type": "string",
      "title": "Game Key",
      "description": "Game key, typically 'nfl' for football",
      "default": "nfl"
    },
    "team_key": {
      "type": "string",
      "title": "Your Team Key",
      "description": "Optional team key e.g., 12345.nfl.t.5 to focus on your team",
      "default": ""
    },
    "display_mode": {
      "type": "string",
      "title": "Display Mode",
      "description": "standings, scoreboard, or myteam",
      "enum": ["standings", "scoreboard", "myteam"],
      "default": "standings"
    },
    "layout": {
      "type": "string",
      "title": "Layout",
      "description": "auto, compact, wide, large",
      "enum": ["auto", "compact", "wide", "large"],
      "default": "auto"
    },
    "enable_scroll": {
      "type": "boolean",
      "title": "Enable Scrolling",
      "description": "Scroll through lines when more data than fits",
      "default": false
    },
    "scroll_speed": {
      "type": "integer",
      "title": "Scroll Speed",
      "description": "Pixels per tick",
      "default": 2,
      "minimum": 1,
      "maximum": 10
    },
    "max_lines": {
      "type": "integer",
      "title": "Max Lines",
      "description": "0 = auto based on layout",
      "default": 0,
      "minimum": 0
    },
    "dry_run": {
      "type": "boolean",
      "title": "Dry Run Mode",
      "description": "Use mock data instead of Yahoo API for testing layout/scrolling",
      "default": true
    },
    "display_duration": {
      "type": "integer",
      "title": "Display Duration Seconds",
      "default": 30
    },
    "update_interval": {
      "type": "integer",
      "title": "Update Interval Seconds",
      "description": "How often to refresh data",
      "default": 300
    },
    "color": {
      "type": "array",
      "title": "Text Color",
      "items": {"type": "integer", "minimum": 0, "maximum": 255},
      "minItems": 3,
      "maxItems": 3,
      "default": [255, 255, 255]
    }
  }
}